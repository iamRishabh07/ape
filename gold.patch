+++ b/solution/route53.tf
@@ -0,0 +1,25 @@
+################################################################################
+# Route53 private hosted zone for VPC Lattice service discovery
+# Associated with both client VPC (inline) and cluster VPC (explicit resource)
+################################################################################
+
+resource "aws_route53_zone" "primary" {
+  name    = "example.com"
+  comment = "Private hosted zone for VPC Lattice service discovery"
+
+  vpc {
+    vpc_id = aws_vpc.client.id
+  }
+
+  tags = local.tags
+}
+
+################################################################################
+# Associate Route53 zone with cluster VPC so EKS workloads can resolve
+# VPC Lattice service DNS names via the private hosted zone
+################################################################################
+
+resource "aws_route53_zone_association" "cluster" {
+  zone_id = aws_route53_zone.primary.zone_id
+  vpc_id  = aws_vpc.cluster.id
+}
